SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
YELO_INFERENCE_HOST=0.0.0.0
YELO_INFERENCE_PORT=8000
# How long camera config (zones, delays) is cached before re-fetching.
YELO_TOKEN_CACHE_SECONDS=10
# Weights live in the models/ directory at the repository root.
#   models/yolo_garbage.pt  our custom litter model (recommended)
#   models/yolo26n.pt       pretrained COCO, fastest
#   models/yolo26s.pt       pretrained COCO
#   models/yolo26m.pt       pretrained COCO, slow on CPU
#   models/yolo26l.pt       pretrained COCO, slowest
# A bare file name also works; the gateway looks inside models/ automatically.
YELO_MODEL_PATH=models/yolo_garbage.pt
YELO_MODEL_DEVICE=cpu
YELO_MODEL_CONFIDENCE=0.2
# 480 suits the custom model on CPU; 960 is only sensible with a GPU.
YELO_MODEL_IMAGE_SIZE=480
YELO_TRACKER_CONFIG=bytetrack.yaml
YELO_TRACKER_STALE_SECONDS=120
YELO_TRACK_HISTORY_LENGTH=20
YELO_EVENT_STATIONARY_DISTANCE=0.015
YELO_EVENT_PERSON_DISTANCE=0.75
YELO_EVENT_PERSON_MEMORY_SECONDS=15
YELO_EVENT_CANDIDATE_GRACE_SECONDS=12
YELO_EVENT_COOLDOWN_SECONDS=120
# Optional override; defaults to SUPABASE_URL/functions/v1/report-camera-event
YELO_EVENT_REPORT_URL=
# Before/after evidence clips for confirmed events (played back in real time).
YELO_CLIP_ENABLED=1
YELO_CLIP_PRE_SECONDS=60
YELO_CLIP_POST_SECONDS=60
YELO_CLIP_OUTPUT_FPS=15
YELO_CLIP_SOURCE_FPS=0.7
YELO_CLIP_WIDTH=640
# Optional override; defaults to SUPABASE_URL/functions/v1/attach-event-clip
YELO_CLIP_REPORT_URL=
# Comma-separated labels treated as waste candidates.
YELO_WASTE_CLASSES=bottle,cup,bowl,banana,apple,orange,backpack,handbag,suitcase
# Optional comma-separated labels, for example: person,bottle,cup
YELO_DETECTION_CLASSES=
